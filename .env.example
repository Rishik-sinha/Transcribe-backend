# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase — from Project Settings > API in your Supabase dashboard.
# The SERVICE ROLE key is backend-only (bypasses RLS); never ship it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider — NOT tied to Gemini. Pick one and paste its key.
#   groq     = https://console.groq.com/keys          (Whisper + Llama)
#   openai   = https://platform.openai.com/api-keys   (Whisper + GPT)
#   deepgram = https://console.deepgram.com/          (Nova ASR)
#   gemini   = https://aistudio.google.com/apikey     (Gemini)
# There is no mock provider: a real key is required to transcribe recordings.
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides (sensible defaults exist per provider):
# AI_BASE_URL=
# AI_MODEL=
# AI_SUMMARIZE_MODEL=
